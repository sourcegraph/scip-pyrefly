{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "description": "Brings nixpkgs fixes into the image before the scheduled release.",
    "enabled": true,
    "schedule": ["* 0-3 * * 1"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "(?:repo|repository): (?<depName>[^\\s${]+)\\s+ref: (?<currentValue>[^\\s${]+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version = \"(?<currentValue>[^\"]+)\";"
      ]
    }
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Merge non-major updates once CI passes; major updates need review.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "A NixOS release upgrade, such as nixos-26.05 to nixos-26.11, changes every package in the image.",
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "description": "pyrefly updates change the index, which CI only checks for size and a few files. The release-hashes workflow adds the new hashes in a second commit; wait for CI on it.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["flake.nix"],
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/ci.yaml"],
      "schedule": ["* * 1 */3 *"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
